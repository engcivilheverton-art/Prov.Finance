rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Perfil do usuário: nome obrigatório, idade opcional e período dos gráficos válido.
    function perfilValido(d) {
      return d.keys().hasOnly(['nome', 'idade', 'anoIni', 'mesIni', 'anoFim', 'mesFim', 'atualizadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && (!('idade' in d) || (d.idade is int && d.idade >= 0 && d.idade <= 120))
        && d.anoIni is int && d.anoIni >= 2022 && d.anoIni <= 2030
        && d.anoFim is int && d.anoFim >= 2022 && d.anoFim <= 2030
        && d.mesIni is int && d.mesIni >= 1 && d.mesIni <= 12
        && d.mesFim is int && d.mesFim >= 1 && d.mesFim <= 12
        && (d.anoIni * 12 + d.mesIni) <= (d.anoFim * 12 + d.mesFim);
    }

    // Perfil (validado) — só o próprio dono.
    match /users/{uid}/perfil/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && docId == 'dados' && perfilValido(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Caixinhas — cada caixa pertence ao usuário e tem nome/percentual próprios.
    function percentualValido(v) { return v is number && v >= 0 && v <= 100; }
    function caixaLegadaValida(d) {
      return d.keys().hasOnly(['pct', 'atualizadoEm', 'migrado'])
        && d.pct is map
        && d.pct.keys().hasOnly(['fixas', 'cartaoDividas', 'dizimo', 'lazer', 'investimento'])
        && percentualValido(d.pct.fixas)
        && percentualValido(d.pct.cartaoDividas)
        && percentualValido(d.pct.dizimo)
        && percentualValido(d.pct.lazer)
        && percentualValido(d.pct.investimento)
        && (!('migrado' in d) || d.migrado is bool);
    }
    function caixaUsuarioValida(d) {
      return d.keys().hasOnly(['nome', 'percentual', 'icone', 'cor', 'origem', 'ativa', 'atualizadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 40
        && percentualValido(d.percentual)
        && d.icone is string && d.icone.size() <= 8
        && d.cor is string && d.cor.matches('^#[0-9A-Fa-f]{6}$')
        && d.origem in ['manual', 'fixas', 'cartaoDividas']
        && d.ativa is bool;
    }
    function gastoLegadoValido(d) {
      return d.keys().hasOnly(['valores', 'atualizadoEm'])
        && d.valores is map
        && d.valores.keys().hasOnly(['fixas', 'cartaoDividas', 'dizimo', 'lazer', 'investimento'])
        && (!('fixas' in d.valores) || (d.valores.fixas is number && d.valores.fixas >= 0))
        && (!('cartaoDividas' in d.valores) || (d.valores.cartaoDividas is number && d.valores.cartaoDividas >= 0))
        && (!('dizimo' in d.valores) || (d.valores.dizimo is number && d.valores.dizimo >= 0))
        && (!('lazer' in d.valores) || (d.valores.lazer is number && d.valores.lazer >= 0))
        && (!('investimento' in d.valores) || (d.valores.investimento is number && d.valores.investimento >= 0));
    }
    function gastoUsuarioValido(uid, id, d) {
      return d.keys().hasOnly(['ym', 'caixinhaId', 'valor', 'atualizadoEm'])
        && d.ym is string && d.ym.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.caixinhaId is string && d.caixinhaId.size() > 0 && d.caixinhaId.size() <= 64
        && id == d.ym + '_' + d.caixinhaId
        && d.valor is number && d.valor >= 0 && d.valor <= 1000000000
        && exists(/databases/$(database)/documents/users/$(uid)/caixinhas/$(d.caixinhaId));
    }
    match /users/{uid}/caixinhas/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && (
        (docId == 'config' && caixaLegadaValida(request.resource.data))
        || (docId.matches('^[A-Za-z0-9_-]{1,64}$') && docId != 'config' && caixaUsuarioValida(request.resource.data))
      );
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/caixinhasGastos/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && ((id.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && gastoLegadoValido(request.resource.data))
          || (id.matches('^[0-9]{4}-(0[1-9]|1[0-2])_[A-Za-z0-9_-]{1,64}$') && gastoUsuarioValido(uid, id, request.resource.data)));
      allow delete: if isOwner(uid);
    }

    // Assinatura pode ser consultada pelo próprio usuário, mas só o backend (Admin SDK/REST) a altera.
    match /users/{uid}/assinatura/{docId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Cartões e faturas: manter cadastro manual no Free; gravação de CSV é exclusiva do backend.
    match /users/{uid}/cartoes/{cartaoId} {
      allow read: if isOwner(uid);
      // A criação passa pela API/Admin, que verifica o plano e conta os registros existentes.
      allow create: if false;
      allow update, delete: if isOwner(uid);
    }
    match /users/{uid}/cartoes/{cartaoId}/faturas/{ym} {
      allow read, delete: if isOwner(uid);
      // Criação e troca da origem para CSV são exclusivas do backend; edição manual preserva a origem existente.
      allow create: if isOwner(uid) && request.resource.data.origem != 'csv';
      allow update: if isOwner(uid) && request.resource.data.origem == resource.data.origem;
    }
    match /users/{uid}/cartoes/{cartaoId}/faturas/{ym}/itens/{itemId} {
      allow read: if isOwner(uid);
      // Novos lançamentos CSV só podem ser gravados pelo backend após reconfirmação no Mercado Pago.
      allow create, update: if false;
      allow delete: if isOwner(uid); // permite que Free remova dados CSV antigos sem importar novos
    }

    // Demais dados financeiros — só o próprio dono. As áreas com regras específicas acima são excluídas.
    match /users/{uid}/{colecao}/{docId=**} {
      allow read: if isOwner(uid) && colecao != 'perfil' && colecao != 'assinatura' && colecao != 'cartoes' && colecao != 'planLocks' && colecao != 'caixinhas' && colecao != 'caixinhasGastos';
      allow create: if isOwner(uid) && colecao != 'perfil' && colecao != 'assinatura' && colecao != 'cartoes' && colecao != 'planLocks' && colecao != 'dividas' && colecao != 'fixas' && colecao != 'caixinhas' && colecao != 'caixinhasGastos';
      allow update, delete: if isOwner(uid) && colecao != 'perfil' && colecao != 'assinatura' && colecao != 'cartoes' && colecao != 'planLocks' && colecao != 'caixinhas' && colecao != 'caixinhasGastos';
    }

    // Tudo o mais é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
