rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Perfil do usuário: nome obrigatório, idade opcional e período dos gráficos válido.
    function perfilValido(d) {
      return d.keys().hasOnly(['nome', 'idade', 'anoIni', 'mesIni', 'anoFim', 'mesFim', 'atualizadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && (!('idade' in d) || (d.idade is int && d.idade >= 0 && d.idade <= 120))
        && d.anoIni is int && d.anoIni >= 2022 && d.anoIni <= 2030
        && d.anoFim is int && d.anoFim >= 2022 && d.anoFim <= 2030
        && d.mesIni is int && d.mesIni >= 1 && d.mesIni <= 12
        && d.mesFim is int && d.mesFim >= 1 && d.mesFim <= 12
        && (d.anoIni * 12 + d.mesIni) <= (d.anoFim * 12 + d.mesFim);
    }

    // Perfil (validado) — só o próprio dono.
    match /users/{uid}/perfil/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && docId == 'dados' && perfilValido(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Caixinhas — cada caixa pertence ao usuário e tem nome/percentual próprios.
    function percentualValido(v) { return v is number && v >= 0 && v <= 100; }
    function caixaLegadaValida(d) {
      return d.keys().hasOnly(['pct', 'atualizadoEm', 'migrado'])
        && d.pct is map
        && d.pct.keys().hasOnly(['fixas', 'cartaoDividas', 'dizimo', 'lazer', 'investimento'])
        && percentualValido(d.pct.fixas)
        && percentualValido(d.pct.cartaoDividas)
        && percentualValido(d.pct.dizimo)
        && percentualValido(d.pct.lazer)
        && percentualValido(d.pct.investimento)
        && (!('migrado' in d) || d.migrado is bool);
    }
    function caixaUsuarioValida(d) {
      return d.keys().hasOnly(['nome', 'percentual', 'icone', 'cor', 'origem', 'ativa', 'atualizadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 40
        && percentualValido(d.percentual)
        && d.icone is string && d.icone.size() <= 8
        && d.cor is string && d.cor.matches('^#[0-9A-Fa-f]{6}$')
        && d.origem in ['manual', 'fixas', 'cartaoDividas']
        && d.ativa is bool;
    }
    function gastoLegadoValido(d) {
      return d.keys().hasOnly(['valores', 'atualizadoEm'])
        && d.valores is map
        && d.valores.keys().hasOnly(['fixas', 'cartaoDividas', 'dizimo', 'lazer', 'investimento'])
        && (!('fixas' in d.valores) || (d.valores.fixas is number && d.valores.fixas >= 0))
        && (!('cartaoDividas' in d.valores) || (d.valores.cartaoDividas is number && d.valores.cartaoDividas >= 0))
        && (!('dizimo' in d.valores) || (d.valores.dizimo is number && d.valores.dizimo >= 0))
        && (!('lazer' in d.valores) || (d.valores.lazer is number && d.valores.lazer >= 0))
        && (!('investimento' in d.valores) || (d.valores.investimento is number && d.valores.investimento >= 0));
    }
    function gastoUsuarioValido(uid, id, d) {
      return d.keys().hasOnly(['ym', 'caixinhaId', 'valor', 'atualizadoEm'])
        && d.ym is string && d.ym.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.caixinhaId is string && d.caixinhaId.size() > 0 && d.caixinhaId.size() <= 64
        && id == d.ym + '_' + d.caixinhaId
        && d.valor is number && d.valor >= 0 && d.valor <= 1000000000
        && exists(/databases/$(database)/documents/users/$(uid)/caixinhas/$(d.caixinhaId));
    }
    match /users/{uid}/caixinhas/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && (
        (docId == 'config' && caixaLegadaValida(request.resource.data))
        || (docId.matches('^[A-Za-z0-9_-]{1,64}$') && docId != 'config' && caixaUsuarioValida(request.resource.data))
      );
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/caixinhasGastos/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && ((id.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && gastoLegadoValido(request.resource.data))
          || (id.matches('^[0-9]{4}-(0[1-9]|1[0-2])_[A-Za-z0-9_-]{1,64}$') && gastoUsuarioValido(uid, id, request.resource.data)));
      allow delete: if isOwner(uid);
    }

    // Assinatura pode ser consultada pelo próprio usuário, mas só o backend (Admin SDK/REST) a altera.
    match /users/{uid}/assinatura/{docId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Cartões e faturas: manter cadastro manual no Free; gravação de CSV é exclusiva do backend.
    match /users/{uid}/cartoes/{cartaoId} {
      allow read: if isOwner(uid);
      // A criação passa pela API/Admin, que verifica o plano e conta os registros existentes.
      allow create: if false;
      allow update, delete: if isOwner(uid);
    }
    match /users/{uid}/cartoes/{cartaoId}/faturas/{ym} {
      allow read, delete: if isOwner(uid);
      // Criação e troca da origem para CSV são exclusivas do backend; edição manual preserva a origem existente.
      allow create: if isOwner(uid) && request.resource.data.origem != 'csv';
      allow update: if isOwner(uid) && request.resource.data.origem == resource.data.origem;
    }
    match /users/{uid}/cartoes/{cartaoId}/faturas/{ym}/itens/{itemId} {
      allow read: if isOwner(uid);
      // Novos lançamentos CSV só podem ser gravados pelo backend após reconfirmação no Mercado Pago.
      allow create, update: if false;
      allow delete: if isOwner(uid); // permite que Free remova dados CSV antigos sem importar novos
    }

    // Contas bancárias: a criação é exclusiva da API, que valida o limite Free.
    // Movimentações são acessíveis apenas pelo proprietário; transferências guardam pares no mesmo usuário.
    function contaBancariaValida(d) {
      return d.keys().hasOnly(['nome', 'instituicao', 'tipo', 'saldoInicial', 'dataSaldoInicial', 'cor', 'logo', 'arquivada', 'criadaEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 50
        && d.instituicao is string && d.instituicao.size() > 0 && d.instituicao.size() <= 60
        && d.tipo in ['corrente', 'poupanca', 'digital', 'dinheiro']
        && d.saldoInicial is number && d.saldoInicial >= -1000000000 && d.saldoInicial <= 1000000000
        && d.dataSaldoInicial is string && d.dataSaldoInicial.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.cor is string && d.cor.matches('^#[0-9A-Fa-f]{6}$')
        && (!('logo' in d) || (d.logo is string && d.logo.size() <= 200))
        && d.arquivada is bool;
    }
    function movimentacaoContaValida(d) {
      return d.keys().hasOnly(['tipo', 'direcao', 'valor', 'data', 'descricao', 'categoriaId', 'observacao', 'contaDestinoId', 'transferenciaId', 'importacaoId', 'chaveDuplicidade', 'origem', 'ignorada', 'cartaoId', 'ymFatura'])
        && d.tipo in ['entrada', 'saida', 'transferencia', 'pagamento_fatura']
        && d.valor is number && d.valor > 0 && d.valor <= 1000000000
        && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 300
        && d.origem in ['manual', 'csv', 'ofx']
        && (!('direcao' in d) || d.direcao in ['entrada', 'saida'])
        && (!('categoriaId' in d) || (d.categoriaId is string && d.categoriaId.size() <= 64))
        && (!('observacao' in d) || (d.observacao is string && d.observacao.size() <= 500))
        && (!('ignorada' in d) || d.ignorada is bool)
        && (!('contaDestinoId' in d) || (d.contaDestinoId is string && d.contaDestinoId.size() <= 128))
        && (!('transferenciaId' in d) || (d.transferenciaId is string && d.transferenciaId.size() <= 128))
        && (!('importacaoId' in d) || (d.importacaoId is string && d.importacaoId.size() <= 128))
        && (!('chaveDuplicidade' in d) || (d.chaveDuplicidade is string && d.chaveDuplicidade.size() <= 128))
        && (!('cartaoId' in d) || (d.cartaoId is string && d.cartaoId.size() <= 128))
        && (!('ymFatura' in d) || (d.ymFatura is string && d.ymFatura.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')));
    }
    match /users/{uid}/contas/{contaId} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if isOwner(uid) && contaBancariaValida(request.resource.data);
      allow delete: if isOwner(uid);
      match /movimentacoes/{movimentacaoId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.origem == 'manual' && movimentacaoContaValida(request.resource.data);
        allow update: if isOwner(uid) && request.resource.data.origem == resource.data.origem && movimentacaoContaValida(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }
    match /users/{uid}/modelosImportacaoExtrato/{contaId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['banco', 'mapeamento', 'atualizadoEm'])
        && request.resource.data.banco is string && request.resource.data.banco.size() <= 60
        && request.resource.data.mapeamento is map
        && request.resource.data.mapeamento.keys().hasOnly(['data', 'descricao', 'valor', 'debito', 'credito'])
        && request.resource.data.mapeamento.data is int && request.resource.data.mapeamento.data >= 0 && request.resource.data.mapeamento.data <= 100
        && request.resource.data.mapeamento.descricao is int && request.resource.data.mapeamento.descricao >= 0 && request.resource.data.mapeamento.descricao <= 100
        && (!('valor' in request.resource.data.mapeamento) || (request.resource.data.mapeamento.valor is int && request.resource.data.mapeamento.valor >= 0 && request.resource.data.mapeamento.valor <= 100))
        && (!('debito' in request.resource.data.mapeamento) || (request.resource.data.mapeamento.debito is int && request.resource.data.mapeamento.debito >= 0 && request.resource.data.mapeamento.debito <= 100))
        && (!('credito' in request.resource.data.mapeamento) || (request.resource.data.mapeamento.credito is int && request.resource.data.mapeamento.credito >= 0 && request.resource.data.mapeamento.credito <= 100));
      allow delete: if isOwner(uid);
    }

    // Categorias editáveis do usuário. O marcador impede que categorias apagadas sejam semeadas de novo.
    function categoriaValida(d) {
      return d.keys().hasOnly(['nome', 'palavras', 'ordem', 'arquivada'])
        && d.nome is string && d.nome.size() >= 1 && d.nome.size() <= 30
        && d.palavras is list && d.palavras.size() <= 100
        && d.ordem is int && d.ordem >= 0 && d.ordem <= 49
        && (!('arquivada' in d) || d.arquivada is bool);
    }
    match /users/{uid}/categorias/{categoriaId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && (
        (categoriaId == '__meta_seed' && request.resource.data.keys().hasOnly(['semeado']) && request.resource.data.semeado == true)
        || (categoriaId.matches('^[A-Za-z0-9_-]{1,64}$') && categoriaId != '__meta_seed' && categoriaValida(request.resource.data))
      );
      allow delete: if isOwner(uid) && categoriaId != '__meta_seed';
    }
    match /users/{uid}/regrasCategoria/{regraId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && regraId.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['chave', 'categoriaId'])
        && request.resource.data.chave is string && request.resource.data.chave.size() >= 1 && request.resource.data.chave.size() <= 200
        && request.resource.data.categoriaId is string && request.resource.data.categoriaId.size() >= 1 && request.resource.data.categoriaId.size() <= 64
        && request.resource.data.categoriaId != '__meta_seed'
        && exists(/databases/$(database)/documents/users/$(uid)/categorias/$(request.resource.data.categoriaId));
      allow delete: if isOwner(uid) && regraId.matches('^[0-9a-f]{64}$');
    }
    // Regras de tratamento de CSV gravadas apenas pelo backend/Admin SDK.
    match /users/{uid}/regrasImportacaoCsv/{regraId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Demais dados financeiros — só o próprio dono. As áreas com regras específicas acima são excluídas.
    match /users/{uid}/{colecao}/{docId=**} {
      allow read: if isOwner(uid) && colecao != 'perfil' && colecao != 'assinatura' && colecao != 'cartoes' && colecao != 'contas' && colecao != 'modelosImportacaoExtrato' && colecao != 'planLocks' && colecao != 'caixinhas' && colecao != 'caixinhasGastos' && colecao != 'categorias' && colecao != 'regrasCategoria' && colecao != 'regrasImportacaoCsv';
      allow create: if isOwner(uid) && colecao != 'perfil' && colecao != 'assinatura' && colecao != 'cartoes' && colecao != 'contas' && colecao != 'modelosImportacaoExtrato' && colecao != 'planLocks' && colecao != 'dividas' && colecao != 'fixas' && colecao != 'caixinhas' && colecao != 'caixinhasGastos' && colecao != 'categorias' && colecao != 'regrasCategoria' && colecao != 'regrasImportacaoCsv';
      allow update, delete: if isOwner(uid) && colecao != 'perfil' && colecao != 'assinatura' && colecao != 'cartoes' && colecao != 'contas' && colecao != 'modelosImportacaoExtrato' && colecao != 'planLocks' && colecao != 'caixinhas' && colecao != 'caixinhasGastos' && colecao != 'categorias' && colecao != 'regrasCategoria' && colecao != 'regrasImportacaoCsv';
    }

    // Tudo o mais é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
