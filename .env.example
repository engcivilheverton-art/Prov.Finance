# Desenvolvimento local com emuladores (não precisa de conta Firebase)
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-prov-financeiro

# Produção: preencha com os dados do app web no console do Firebase e use NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-prov-financeiro.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend de assinatura no Vercel (nunca use NEXT_PUBLIC_ nestas chaves)
NEXT_PUBLIC_APP_URL=https://prov-financeiro.vercel.app
FIREBASE_ADMIN_PROJECT_ID=provfinance-33283
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Apenas no Preview: e-mail da conta compradora de teste do Mercado Pago
MERCADOPAGO_TEST_PAYER_EMAIL=
