# Desenvolvimento local com emuladores (não precisa de conta Firebase)
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-prov-financeiro
FIREBASE_ADMIN_PROJECT_ID=demo-prov-financeiro

# Produção: preencha com os dados do app web no console do Firebase e use NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-prov-financeiro.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL de origem deste aplicativo (usada nos retornos do checkout)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend de produção: credenciais privadas da conta de serviço Firebase.
# Emuladores locais usam credenciais fictícias e não precisam desta chave.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Mercado Pago: credenciais por ambiente na Vercel. Preview usa credenciais de teste;
# Production usa credenciais reais. Nunca exponha o Access Token no frontend.
MERCADOPAGO_ACCESS_TOKEN=
# Opcional somente em local/Preview para pagar como a conta compradora de teste.
MERCADOPAGO_TEST_PAYER_EMAIL=
# Segredo de assinatura HMAC do webhook correspondente ao mesmo ambiente.
MERCADOPAGO_WEBHOOK_SECRET=
