# Desenvolvimento local com emuladores (não precisa de conta Firebase)
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-prov-financeiro

# Produção: preencha com os dados do app web no console do Firebase e use NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-prov-financeiro.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=
